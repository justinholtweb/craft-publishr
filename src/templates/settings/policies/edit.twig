{% extends "publishr/_layouts/screen" %}
{% import "_includes/forms.twig" as forms %}
{% set selectedSubnavItem = 'settings' %}
{% set selectedTab = 'policies' %}
{% set readOnly = readOnly ?? not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% set crumbs = [
    { label: "Publishr"|t('publishr'), url: url('publishr') },
    { label: "Freshness"|t('publishr'), url: url('publishr/settings/policies') },
] %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
    {% if not readOnly %}
        {{ actionInput('publishr/policies/save') }}
        {{ redirectInput('publishr/settings/policies') }}
        {% if not isNew %}{{ hiddenInput('policyId', policy.id) }}{% endif %}
    {% endif %}

    {{ forms.textField({
        first: true,
        label: "Name"|t('publishr'),
        id: 'name',
        name: 'name',
        value: policy.name,
        errors: policy.getErrors('name'),
        autofocus: isNew,
        required: true,
        disabled: readOnly,
    }) }}

    {{ forms.textField({
        label: "Handle"|t('publishr'),
        id: 'handle',
        name: 'handle',
        value: policy.handle,
        errors: policy.getErrors('handle'),
        class: 'code',
        required: true,
        disabled: readOnly,
    }) }}

    {{ forms.textField({
        label: "Good for this many days"|t('publishr'),
        instructions: "Counted from the last review, or from the post date when there has never been one."|t('publishr'),
        name: 'intervalDays',
        type: 'number',
        value: policy.intervalDays,
        size: 6,
        errors: policy.getErrors('intervalDays'),
        disabled: readOnly,
    }) }}

    {{ forms.textField({
        label: "Warn this many days early"|t('publishr'),
        name: 'remindDaysBefore',
        type: 'number',
        value: policy.remindDaysBefore,
        size: 6,
        errors: policy.getErrors('remindDaysBefore'),
        disabled: readOnly,
    }) }}

    {{ forms.checkboxSelectField({
        label: "Sections"|t('publishr'),
        instructions: "Empty covers every section."|t('publishr'),
        name: 'sectionUids',
        options: sections|map(s => { label: s.name, value: s.uid }),
        values: policy.sectionUids,
        showAllOption: false,
        disabled: readOnly,
    }) }}

    {{ forms.checkboxSelectField({
        label: "Entry types"|t('publishr'),
        instructions: "Empty covers every type in those sections."|t('publishr'),
        name: 'entryTypeUids',
        options: entryTypes|map(t => { label: t.name, value: t.uid }),
        values: policy.entryTypeUids,
        showAllOption: false,
        disabled: readOnly,
    }) }}

    {{ forms.selectField({
        label: "Who reviews it"|t('publishr'),
        instructions: "Only ever fills in an empty owner. A policy never takes a live piece away from the person still working on it."|t('publishr'),
        id: 'assignTo',
        name: 'assignTo',
        toggle: true,
        targetPrefix: 'assign-',
        options: [
            { label: "Whoever already owns it"|t('publishr'), value: 'current' },
            { label: "The entry’s author"|t('publishr'), value: 'author' },
            { label: "One named person"|t('publishr'), value: 'user' },
            { label: "Nobody"|t('publishr'), value: 'nobody' },
        ],
        value: policy.assignTo,
        disabled: readOnly,
    }) }}

    <div id="assign-user" class="{{ policy.assignTo != 'user' ? 'hidden' }}">
        {{ forms.elementSelectField({
            label: "Named reviewer"|t('publishr'),
            id: 'assigneeId',
            name: 'assigneeId',
            elementType: 'craft\elements\User',
            limit: 1,
            elements: assignee ? [assignee] : [],
            errors: policy.getErrors('assigneeId'),
            disabled: readOnly,
        }) }}
    </div>

    {{ forms.lightswitchField({
        label: "Enabled"|t('publishr'),
        name: 'enabled',
        on: policy.enabled,
        disabled: readOnly,
    }) }}

    {% if isNew and not readOnly %}
        {% js %}
            new Craft.HandleGenerator('#name', '#handle');
        {% endjs %}
    {% endif %}
{% endblock %}
