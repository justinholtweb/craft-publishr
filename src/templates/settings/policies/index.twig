{% extends "publishr/_layouts/screen" %}
{% set selectedSubnavItem = 'settings' %}
{% set selectedTab = 'policies' %}

{% block screenActions %}
    {% if allowed %}
        <a class="btn submit add icon" href="{{ url('publishr/settings/policies/new') }}">{{ "New policy"|t('publishr') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% include "publishr/settings/_nav" %}

    {% if not allowed %}
        <div class="pub-note pub-note--pro">{{ "Freshness reviews are a Pro feature."|t('publishr') }}</div>
    {% endif %}

    <p class="light">
        {{ "Nothing on a website tells you it has gone out of date. A policy says how long a kind of content stays good for, and the interval runs from the last human review — or from the post date when there has never been one, so the first sweep shows the real backlog."|t('publishr') }}
    </p>

    <div class="pub-stats">
        <div class="pub-stat"><span class="pub-stat__n">{{ summary.scheduled }}</span><span class="pub-stat__l">{{ "on a cycle"|t('publishr') }}</span></div>
        <div class="pub-stat"><span class="pub-stat__n">{{ summary.due }}</span><span class="pub-stat__l">{{ "overdue"|t('publishr') }}</span></div>
        <div class="pub-stat"><span class="pub-stat__n">{{ summary.neverReviewed }}</span><span class="pub-stat__l">{{ "never reviewed"|t('publishr') }}</span></div>
    </div>

    {% if policies is empty %}
        <div class="pub-empty">{{ "No policies yet."|t('publishr') }}</div>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ "Policy"|t('publishr') }}</th>
                    <th>{{ "Interval"|t('publishr') }}</th>
                    <th>{{ "Covers"|t('publishr') }}</th>
                    <th>{{ "Reviewer"|t('publishr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for policy in policies %}
                    <tr class="{{ policy.enabled ? '' : 'disabled' }}">
                        <td><a href="{{ url('publishr/settings/policies/' ~ policy.id) }}">{{ policy.name }}</a></td>
                        <td>{{ "{n} days"|t('publishr', { n: policy.intervalDays }) }}</td>
                        <td class="light">
                            {{ policy.sectionUids ? "{n} sections"|t('publishr', { n: policy.sectionUids|length }) : "everything"|t('publishr') }}
                        </td>
                        <td class="light">{{ policy.assignTo }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="light" style="font-size:12px;">
            {{ "First match wins, in this order. Not “most specific” — specificity has no reliable ordering once a policy can name both sections and entry types."|t('publishr') }}
        </p>
    {% endif %}
{% endblock %}
