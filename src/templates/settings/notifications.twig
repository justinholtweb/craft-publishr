{% extends "publishr/_layouts/screen" %}
{% import "_includes/forms.twig" as forms %}
{% set selectedSubnavItem = 'settings' %}
{% set selectedTab = 'notifications' %}
{% set readOnly = readOnly ?? not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include "publishr/settings/_nav" with { selectedTab: selectedTab } only %}
{% endblock %}

{% block content %}
    {% if not allowsNotifications %}
        <p class="notice has-icon"><span class="icon" aria-hidden="true"></span><span>{{ "Notifications and the digest are Pro features. Everything below is saved, and starts working the moment the licence is upgraded."|t('publishr') }}</span></p>
    {% endif %}

    {% if not readOnly %}
        {{ actionInput('publishr/settings/save') }}
        {{ redirectInput('publishr/settings/notifications') }}
    {% endif %}

        {{ forms.lightswitchField({
            label: "Send notifications"|t('publishr'),
            name: 'settings[notificationsEnabled]',
            on: settings.notificationsEnabled,
            disabled: readOnly,
        }) }}

        {{ forms.textField({
            label: "Warn this many days before a deadline"|t('publishr'),
            name: 'settings[dueSoonDays]',
            type: 'number',
            value: settings.dueSoonDays,
            size: 4,
            errors: settings.getErrors('dueSoonDays'),
            disabled: readOnly,
        }) }}

        {{ forms.lightswitchField({
            label: "Send through the queue"|t('publishr'),
            instructions: "On, so a stage move never waits on an SMTP handshake."|t('publishr'),
            name: 'settings[queueNotifications]',
            on: settings.queueNotifications,
            disabled: readOnly,
        }) }}

        <hr>
        <h2>{{ "Digest"|t('publishr') }}</h2>

        {{ forms.lightswitchField({
            label: "Send a daily digest"|t('publishr'),
            instructions: "Only to people who have something in it — a mail that says “nothing to report” is a mail people filter."|t('publishr'),
            name: 'settings[digestEnabled]',
            on: settings.digestEnabled,
            disabled: readOnly,
        }) }}

        {{ forms.textField({
            label: "Days it looks ahead"|t('publishr'),
            name: 'settings[digestHorizonDays]',
            type: 'number',
            value: settings.digestHorizonDays,
            size: 4,
            errors: settings.getErrors('digestHorizonDays'),
            disabled: readOnly,
        }) }}

        <div class="smalltext light">
            {{ "The digest goes out when `php craft publishr/sweep --digest=1` runs. Put that on cron once a morning."|t('publishr')|md(inlineOnly=true) }}
        </div>

    {% if problems|length %}
        <hr>
        <h2>{{ "Messages that didn’t go out"|t('publishr') }}</h2>
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>{{ "When"|t('publishr') }}</th>
                    <th>{{ "Event"|t('publishr') }}</th>
                    <th>{{ "Tries"|t('publishr') }}</th>
                    <th>{{ "Error"|t('publishr') }}</th>
                    <th><span class="visually-hidden">{{ "Actions"|t('publishr') }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for row in problems %}
                    <tr>
                        <td class="light">{{ row.dateCreated }}</td>
                        <td>{{ events[row.event] ?? row.event }}</td>
                        <td>{{ row.attempts }}</td>
                        <td class="light">{{ row.error|slice(0, 120) }}</td>
                        <td class="rightalign">
                            {# Inside Craft's main form, so a formsubmit button rather than a form of its own. #}
                            {% if readOnly %}
                                <form method="post" accept-charset="UTF-8">
                                    {{ csrfInput() }}
                                    {{ actionInput('publishr/settings/retry-notification') }}
                                    {{ redirectInput('publishr/settings/notifications') }}
                                    {{ hiddenInput('id', row.id) }}
                                    <button type="submit" class="btn small">{{ "Try again"|t('publishr') }}</button>
                                </form>
                            {% else %}
                                <button type="button" class="btn small formsubmit"
                                        data-action="publishr/settings/retry-notification"
                                        data-redirect="{{ 'publishr/settings/notifications'|hash }}"
                                        data-params="{{ { id: row.id }|json_encode }}">{{ "Try again"|t('publishr') }}</button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
