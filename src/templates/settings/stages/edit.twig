{% extends "publishr/_layouts/screen" %}
{% import "_includes/forms.twig" as forms %}
{% set selectedSubnavItem = 'settings' %}
{% set selectedTab = 'stages' %}
{% set readOnly = readOnly ?? not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% set crumbs = [
    { label: "Publishr"|t('publishr'), url: url('publishr') },
    { label: "Stages"|t('publishr'), url: url('publishr/settings/stages') },
] %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
    {% if not readOnly %}
        {{ actionInput('publishr/stages/save') }}
        {{ redirectInput('publishr/settings/stages') }}
        {% if not isNew %}{{ hiddenInput('stageId', stage.id) }}{% endif %}
    {% endif %}

    {{ forms.textField({
        first: true,
        label: "Name"|t('publishr'),
        id: 'name',
        name: 'name',
        value: stage.name,
        errors: stage.getErrors('name'),
        autofocus: isNew,
        required: true,
        disabled: readOnly,
    }) }}

    {{ forms.textField({
        label: "Handle"|t('publishr'),
        id: 'handle',
        name: 'handle',
        value: stage.handle,
        errors: stage.getErrors('handle'),
        class: 'code',
        required: true,
        disabled: readOnly,
    }) }}

    {{ forms.textareaField({
        label: "What it means"|t('publishr'),
        instructions: "Shown to editors. A stage nobody can define is a stage everybody uses differently."|t('publishr'),
        name: 'description',
        value: stage.description,
        rows: 2,
        disabled: readOnly,
    }) }}

    {# Craft's own colour picker, limited to the colours a stage can carry. #}
    {{ forms.colorSelectField({
        label: "Colour"|t('publishr'),
        id: 'color',
        name: 'color',
        options: colors|map(c => { label: c|title|t('publishr'), value: c, data: { color: c } }),
        withBlankOption: false,
        value: stage.color,
        errors: stage.getErrors('color'),
        disabled: readOnly,
    }) }}

    {{ forms.lightswitchField({
        label: "Where new work starts"|t('publishr'),
        name: 'isDefault',
        on: stage.isDefault,
        disabled: readOnly,
    }) }}

    {{ forms.lightswitchField({
        label: "This is the published stage"|t('publishr'),
        instructions: "Pieces are moved here automatically when they actually go live."|t('publishr'),
        name: 'isPublished',
        on: stage.isPublished,
        errors: stage.getErrors('isPublished'),
        disabled: readOnly,
    }) }}

    {{ forms.lightswitchField({
        label: "Check publish requirements before anything moves here"|t('publishr'),
        name: 'gated',
        on: stage.gated,
        disabled: readOnly,
    }) }}

    {% if isNew and not readOnly %}
        {% js %}
            new Craft.HandleGenerator('#name', '#handle');
        {% endjs %}
    {% endif %}
{% endblock %}
