{% extends "publishr/_layouts/screen" %}
{% import "_includes/forms.twig" as forms %}
{% set selectedSubnavItem = 'settings' %}
{% set selectedTab = 'general' %}
{% set readOnly = readOnly ?? not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
    {% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block sidebar %}
    {% include "publishr/settings/_nav" with { selectedTab: selectedTab } only %}
{% endblock %}

{% block content %}
    <p class="notice has-icon"><span class="icon" aria-hidden="true"></span><span>{{ alarmClock }}</span></p>

    {% if not readOnly %}
        {{ actionInput('publishr/settings/save') }}
        {{ redirectInput('publishr/settings/general') }}
    {% endif %}

        <h2>{{ "What Publishr looks after"|t('publishr') }}</h2>

        {{ forms.checkboxSelectField({
            label: "Sections"|t('publishr'),
            instructions: "Leave every box unticked to manage the whole site. Naming sections makes the calendar faster and keeps 40,000 products off it."|t('publishr'),
            name: 'settings[sections]',
            options: sections|map(s => { label: s.name, value: s.uid }),
            values: settings.sections,
            showAllOption: false,
            disabled: readOnly,
        }) }}

        {{ forms.lightswitchField({
            label: "Track new entries automatically"|t('publishr'),
            instructions: "Off means a piece only appears on the calendar once somebody adds it."|t('publishr'),
            name: 'settings[autoTrack]',
            on: settings.autoTrack,
            disabled: readOnly,
        }) }}

        <hr>
        <h2>{{ "Calendar"|t('publishr') }}</h2>

        {{ forms.checkboxSelectField({
            label: "Lanes shown by default"|t('publishr'),
            name: 'settings[defaultLanes]',
            options: lanes|map(l => { label: laneLabels[l], value: l }),
            values: settings.defaultLanes,
            showAllOption: false,
            disabled: readOnly,
        }) }}

        {{ forms.selectField({
            label: "Week starts on"|t('publishr'),
            name: 'settings[weekStartDay]',
            options: [
                { label: "Sunday"|t('publishr'), value: 0 },
                { label: "Monday"|t('publishr'), value: 1 },
                { label: "Saturday"|t('publishr'), value: 6 },
            ],
            value: settings.weekStartDay,
            errors: settings.getErrors('weekStartDay'),
            disabled: readOnly,
        }) }}

        {{ forms.textField({
            label: "Most pips in a day"|t('publishr'),
            instructions: "Beyond this a cell says “+ 6 more”."|t('publishr'),
            name: 'settings[maxPerDay]',
            type: 'number',
            value: settings.maxPerDay,
            size: 4,
            errors: settings.getErrors('maxPerDay'),
            disabled: readOnly,
        }) }}

        <hr>
        <h2>{{ "Workflow"|t('publishr') }}</h2>

        {{ forms.lightswitchField({
            label: "Move to the published stage when a piece goes live"|t('publishr'),
            instructions: "Alarm Clock notices the moment it happens. Without it, the sweep catches up."|t('publishr'),
            name: 'settings[advanceOnPublish]',
            on: settings.advanceOnPublish,
            disabled: readOnly,
        }) }}

        {{ forms.lightswitchField({
            label: "Clear the deadline once it goes live"|t('publishr'),
            name: 'settings[clearDueOnPublish]',
            on: settings.clearDueOnPublish,
            disabled: readOnly,
        }) }}

        <hr>
        <h2>{{ "Requirements"|t('publishr') }}</h2>

        {% if not isPro %}
            <p class="notice has-icon"><span class="icon" aria-hidden="true"></span><span>{{ "Publish requirements are a Pro feature."|t('publishr') }}</span></p>
        {% endif %}

        {{ forms.lightswitchField({
            label: "Re-check requirements whenever an entry is saved"|t('publishr'),
            name: 'settings[checkGatesOnSave]',
            on: settings.checkGatesOnSave,
            disabled: readOnly or not isPro,
        }) }}

        {{ forms.lightswitchField({
            label: "Refuse to publish an entry whose requirements fail"|t('publishr'),
            instructions: "Off by default. Blocking a stage move is a conversation; blocking a save is a wall. Even on, it only bites when an entry would become public, and never for somebody who can override."|t('publishr'),
            name: 'settings[blockPublish]',
            on: settings.blockPublish,
            disabled: readOnly or not isPro,
            warning: settings.blockPublish ? "This is on. Entries failing a required check cannot be published."|t('publishr') : null,
        }) }}

        <hr>
        <h2>{{ "Freshness"|t('publishr') }}</h2>

        {{ forms.lightswitchField({
            label: "Keep review-by dates"|t('publishr'),
            name: 'settings[freshnessEnabled]',
            on: settings.freshnessEnabled,
            disabled: readOnly or not isPro,
        }) }}

        {{ forms.textField({
            label: "Reviews scheduled per sweep"|t('publishr'),
            instructions: "A policy applied to a long archive matches thousands at once. Batches keep the first sweep from timing out."|t('publishr'),
            name: 'settings[maxReviewsPerSweep]',
            type: 'number',
            value: settings.maxReviewsPerSweep,
            size: 6,
            errors: settings.getErrors('maxReviewsPerSweep'),
            disabled: readOnly or not isPro,
        }) }}

        {{ forms.textField({
            label: "Days of history to keep"|t('publishr'),
            instructions: "0 keeps everything."|t('publishr'),
            name: 'settings[historyRetentionDays]',
            type: 'number',
            value: settings.historyRetentionDays,
            size: 6,
            errors: settings.getErrors('historyRetentionDays'),
            disabled: readOnly,
        }) }}

    <hr>

    {#
        Not a form of its own: on a fullPageForm screen it would be nested inside Craft's, and the
        parser would drop the tag. A formsubmit button posts the main form to a different action.
        Where the screen is read-only there is no main form, so it gets a small one of its own.
    #}
    {% if readOnly %}
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('publishr/settings/sweep') }}
            {{ redirectInput('publishr/settings/general') }}
            <button type="submit" class="btn">{{ "Run the sweep now"|t('publishr') }}</button>
        </form>
    {% else %}
        <button type="button" class="btn formsubmit"
                data-action="publishr/settings/sweep"
                data-redirect="{{ 'publishr/settings/general'|hash }}">{{ "Run the sweep now"|t('publishr') }}</button>
    {% endif %}
    <div class="smalltext light">
        {{ "Advances published pieces, schedules reviews, raises reminders and sends what is waiting. Put `php craft publishr/sweep` on cron for the real thing."|t('publishr')|md(inlineOnly=true) }}
    </div>
{% endblock %}
