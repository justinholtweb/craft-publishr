{% extends "_layouts/cp" %}

{# The shell every Publishr screen shares: the asset bundle, the site switcher and the toolbar. #}

{% do view.registerAssetBundle("justinholtweb\\publishr\\web\\assets\\cp\\CpAsset") %}

{% block actionButton %}
    {% if siteOptions is defined and siteOptions|length > 1 %}
        <div class="flex">
            <label class="visually-hidden" for="pub-site">{{ "Site"|t('publishr') }}</label>
            <div class="select">
                <select id="pub-site">
                    {% for option in siteOptions %}
                        <option value="{{ option.value }}" {{ option.value == siteHandle ? 'selected' }}>{{ option.label }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        {% js %}
            {# Only the site changes. Every other filter on the screen survives the switch. #}
            document.getElementById('pub-site').addEventListener('change', function () {
                var url = new URL(window.location.href);
                url.searchParams.set('site', this.value);
                window.location.href = url.toString();
            });
        {% endjs %}
    {% endif %}
    {% block screenActions %}{% endblock %}
    {# Craft's own Save button, on screens that set fullPageForm. #}
    {{ parent() }}
{% endblock %}
